{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement.schema.json",
  "title": "Requirement",
  "type": "object",
  "required": ["id", "title", "type", "mandatory", "aiRecommendation", "estimatedMM", "confidence", "riskLevel", "evidenceRefs"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "type": { "enum": ["functional", "non_functional", "security", "infrastructure", "migration", "integration", "reporting", "operation", "qa", "pm", "training", "documentation", "compliance", "proposal_item"] },
    "mandatory": { "type": "boolean" },
    "aiRecommendation": { "enum": ["strong_recommend", "recommend", "optional", "not_recommend", "human_review"] },
    "estimatedMM": { "$ref": "estimation.schema.json#/$defs/mmRange" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskLevel": { "enum": ["low", "medium", "high"] },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } }
  }
}
